# Telegram bot — required environment variables.
# Copy to .env and fill in. Never commit .env.

# Get from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>

# Your numeric chat_id (send /start to your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it).
OWNER_CHAT_ID=<YOUR_CHAT_ID>

# Project root the bot is allowed to read/write. Defaults to "." (cwd).
PROJECT_ROOT=.

# Optional: HTTP proxy (e.g. http://user:pass@host:port). Leave empty for direct.
# TELEGRAM_PROXY=

# Optional: enable debug logging
# DEBUG=1